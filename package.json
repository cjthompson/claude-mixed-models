{
  "name": "claude-mixed-models",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test --test-force-exit",
    "proxy": "node --env-file-if-exists=.env proxy/server.js",
    "router": "node --env-file-if-exists=.env router/server.js",
    "stats": "node bin/stats-cli.mjs",
    "install-services": "scripts/install-services.sh",
    "start": "node --env-file-if-exists=.env scripts/server.mjs",
    "stop": "launchctl stop gui/$(id -u)/com.claude-mixed-models.stats",
    "docker:start": "docker compose up -d --build",
    "docker:stop": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "engines": {
    "node": ">=22.5"
  }
}
