# Copy to .env and fill in. .env is gitignored.
ANTHROPIC_API_KEY=sk-ant-...
MINIMAX_API_KEY=...
# Optional overrides
PROXY_PORT=8787
ROUTER_PORT=8788
# Router bind address: 0.0.0.0 accepts LAN clients; restrict this and/or use a
# firewall when the router must not be reachable from the whole LAN.
ROUTER_HOST=0.0.0.0
MINIMAX_BASE_URL=https://api.minimax.io/anthropic
ANTHROPIC_BASE_URL_UPSTREAM=https://api.anthropic.com
# Optional Codex subscription upstream override (non-secret). It must use HTTPS
# unless its host is loopback. Leave unset to retain the tracked default
# https://chatgpt.com/backend-api/codex. ROUTER_PORT must match the port in the
# user-level Codex profile URL (8788 by default).
# OPENAI_SUBSCRIPTION_BASE_URL=https://chatgpt.com/backend-api/codex
# Optional: override which model the main Claude Code loop / diagnostic use
MAIN_MODEL=claude-opus-4-8
MINIMAX_MODEL=MiniMax-M3
# Available MiniMax model aliases (resolved by the router):
#   minimax        -> MiniMax-M3      (default; strongest)
#   minimax-m2.7   -> MiniMax-M2.7    (cheaper; opt in via MAIN_MODEL=minimax-m2.7)
# Optional: which upstream receives bodyless/non-POST requests (default: anthropic)
DEFAULT_UPSTREAM=anthropic

# Usage-stats service. The stats server is a separate plist
# (com.claude-mixed-models.stats -> scripts/server.mjs).
STATS_PORT=8789
STATS_EVENTS_FILE=/tmp/claude-mixed-models/router.events.jsonl
STATS_DB_PATH=$HOME/.local/state/claude-mixed-models/router.stats.db
